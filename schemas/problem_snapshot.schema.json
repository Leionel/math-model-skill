{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/math-modeling-harness/problem-snapshot.schema.json",
  "title": "Problem Snapshot and Requirement Matrix",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "project_id", "competition_profile_id", "captured_at", "problem_files", "attachment_files", "selection", "requirements", "status"],
  "properties": {
    "schema_version": {"type": "string", "const": "1.0"},
    "project_id": {"type": "string", "minLength": 1},
    "competition_profile_id": {"type": "string", "minLength": 1},
    "captured_at": {"type": "string", "minLength": 1},
    "problem_files": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/file_ref"}},
    "attachment_files": {"type": "array", "items": {"$ref": "#/$defs/file_ref"}},
    "selection": {"$ref": "#/$defs/selection"},
    "requirements": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/requirement"}},
    "status": {"type": "string", "enum": ["draft", "confirmed", "superseded"]}
  },
  "$defs": {
    "file_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "source"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[A-Fa-f0-9]{64}$"},
        "source": {"type": "string", "minLength": 1}
      }
    },
    "selection_candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["problem_id", "fit", "data_risk", "validation_risk", "delivery_risk", "decision", "reason"],
      "properties": {
        "problem_id": {"type": "string", "minLength": 1},
        "fit": {"type": "string", "minLength": 1},
        "data_risk": {"type": "string", "enum": ["low", "medium", "high", "unknown"]},
        "validation_risk": {"type": "string", "enum": ["low", "medium", "high", "unknown"]},
        "delivery_risk": {"type": "string", "enum": ["low", "medium", "high", "unknown"]},
        "decision": {"type": "string", "enum": ["selected", "rejected", "not_available"]},
        "reason": {"type": "string", "minLength": 1}
      }
    },
    "selection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["selected_problem_id", "candidates", "confirmed_by_role", "confirmed_at"],
      "properties": {
        "selected_problem_id": {"type": "string", "minLength": 1},
        "candidates": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/selection_candidate"}},
        "confirmed_by_role": {"type": "string", "minLength": 1},
        "confirmed_at": {"type": "string", "minLength": 1}
      }
    },
    "requirement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["requirement_id", "question_id", "source_locator", "official_text", "mathematical_task", "required_outputs", "required_metrics", "special_constraints", "delivery_items", "status"],
      "properties": {
        "requirement_id": {"type": "string", "minLength": 1},
        "question_id": {"type": "string", "pattern": "^q[1-9][0-9]*$"},
        "source_locator": {"type": "string", "minLength": 1},
        "official_text": {"type": "string", "minLength": 1},
        "mathematical_task": {"type": "string", "minLength": 1},
        "required_outputs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "required_metrics": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "special_constraints": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "delivery_items": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "status": {"type": "string", "enum": ["unmapped", "mapped", "answered", "blocked"]}
      }
    }
  }
}
