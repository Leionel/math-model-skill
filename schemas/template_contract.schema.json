{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/math-modeling-harness/template-contract.schema.json",
  "title": "Paper Template Contract",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "template_id", "competition_profile_id", "source_kind", "source_locator", "status", "document_class", "entrypoint", "required_files", "required_commands", "forbidden_document_classes", "allowed_engines"],
  "properties": {
    "schema_version": {"type": "string", "const": "1.0"},
    "template_id": {"type": "string", "minLength": 1},
    "competition_profile_id": {"type": "string", "minLength": 1},
    "source_kind": {"type": "string", "enum": ["official", "community", "user_supplied", "local"]},
    "source_locator": {"type": "string", "minLength": 1},
    "status": {"type": "string", "enum": ["draft", "verified"], "description": "draft=新导入或未验证；verified=模板身份/结构已对齐锁定快照并通过受控导入或初始化流程。verified 只证明模板身份与实际使用一致（check_template_usage.py 可复核），不等于当届官方格式合规；每场比赛仍须 check_pdf.py 按当届 profile 复核。"},
    "document_class": {"type": "string", "pattern": "^[A-Za-z0-9_.-]+$"},
    "entrypoint": {"type": "string", "pattern": "^[^\\\\]*\\.tex$"},
    "required_files": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "required_commands": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "forbidden_document_classes": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^[A-Za-z0-9_.-]+$"}},
    "allowed_engines": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "enum": ["xelatex", "lualatex", "pdflatex"]}},
    "adapter": {
      "type": "object",
      "additionalProperties": false,
      "required": ["family", "body_mode", "metadata_input", "body_input"],
      "properties": {
        "family": {"type": "string", "enum": ["mcm_icm", "cumcm", "generic"]},
        "body_mode": {"type": "string", "const": "replace_demo_body"},
        "metadata_input": {"type": "string", "minLength": 1},
        "body_input": {"type": "string", "minLength": 1}
      }
    },
    "template_snapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_file_count", "source_tree_sha256", "asset_hashes"],
      "properties": {
        "source_file_count": {"type": "integer", "minimum": 1},
        "source_tree_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "asset_hashes": {
          "type": "object",
          "additionalProperties": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
        }
      }
    },
    "notes": {"type": "string"}
  }
}
