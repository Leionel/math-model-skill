{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/math-modeling-harness/frozen-results.schema.json",
  "title": "Frozen Results",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "run_id", "status", "frozen_at", "model_contract_snapshot", "source_snapshot", "input_snapshot", "code_snapshot", "validation_snapshot", "validation_obligations", "command", "seed", "results_sha256", "results"],
  "properties": {
    "schema_version": {"type": "string", "const": "1.1"},
    "run_id": {"type": "string", "minLength": 1},
    "status": {"type": "string", "const": "frozen"},
    "frozen_at": {"type": "string", "minLength": 1},
    "model_contract_snapshot": {"$ref": "#/$defs/file_ref"},
    "source_snapshot": {"$ref": "#/$defs/file_ref"},
    "input_snapshot": {"type": "array", "items": {"$ref": "#/$defs/file_ref"}},
    "code_snapshot": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/file_ref"}},
    "validation_snapshot": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/file_ref"}},
    "validation_obligations": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/validation_obligation"}},
    "command": {"type": "string", "minLength": 1},
    "seed": {"type": ["integer", "null"]},
    "results_sha256": {"type": "string", "pattern": "^[A-Fa-f0-9]{64}$"},
    "results": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/result"}}
  },
  "$defs": {
    "file_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[A-Fa-f0-9]{64}$"}
      }
    },
    "validation_obligation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["obligation_id", "status", "report"],
      "properties": {
        "obligation_id": {"type": "string", "minLength": 1},
        "status": {"type": "string", "const": "pass"},
        "report": {"$ref": "#/$defs/file_ref"}
      }
    },
    "result": {
      "type": "object",
      "additionalProperties": false,
      "required": ["result_id", "question_id", "name", "value", "unit", "precision", "display_value", "statistical_definition", "boundary", "source_artifact", "source_key", "validation_status"],
      "properties": {
        "result_id": {"type": "string", "minLength": 1},
        "question_id": {"type": "string", "pattern": "^q[1-9][0-9]*$"},
        "name": {"type": "string", "minLength": 1},
        "value": {"type": ["number", "string"]},
        "unit": {"type": "string", "minLength": 1},
        "precision": {"type": "integer", "minimum": 0},
        "display_value": {"type": "string", "minLength": 1},
        "statistical_definition": {"type": "string", "minLength": 1},
        "boundary": {"type": "string", "minLength": 1},
        "source_artifact": {"type": "string", "minLength": 1},
        "source_key": {"type": "string", "minLength": 1},
        "validation_status": {"type": "string", "enum": ["passed", "verified"]},
        "notes": {"type": "string"}
      }
    }
  }
}
