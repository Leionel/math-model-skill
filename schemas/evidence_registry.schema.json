{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/math-modeling-harness/evidence-registry.schema.json",
  "title": "Evidence Registry",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "run_id", "generated_from", "evidence"],
  "properties": {
    "schema_version": {"type": "string", "const": "1.0"},
    "run_id": {"type": "string", "minLength": 1},
    "generated_from": {
      "type": "object",
      "additionalProperties": false,
      "required": ["frozen_results_path", "frozen_results_sha256"],
      "properties": {
        "frozen_results_path": {"type": "string", "minLength": 1},
        "frozen_results_sha256": {"type": "string", "pattern": "^[A-Fa-f0-9]{64}$"}
      }
    },
    "evidence": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/evidence"}}
  },
  "$defs": {
    "file_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[A-Fa-f0-9]{64}$"}
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["evidence_id", "type", "result_ids", "artifacts", "supports", "boundary", "verification_status"],
      "properties": {
        "evidence_id": {"type": "string", "minLength": 1},
        "type": {"type": "string", "enum": ["result", "table", "figure", "derivation", "citation"]},
        "result_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "artifacts": {"type": "array", "items": {"$ref": "#/$defs/file_ref"}},
        "citation": {"type": "object", "additionalProperties": true},
        "supports": {"type": "string", "minLength": 1},
        "boundary": {"type": "string", "minLength": 1},
        "verification_status": {"type": "string", "enum": ["pending", "verified", "not_applicable"]}
      }
    }
  }
}
