{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/math-modeling-harness/run-manifest.schema.json",
  "title": "Math Modeling Control Manifest (v2; v1 read compatibility)",
  "description": "v2 is a thin control-plane document. Competition rules, receipts, artifacts and gate verdicts live in their canonical contracts and projections; v1 is accepted only by the migration boundary.",
  "oneOf": [
    { "$ref": "#/$defs/v2" },
    { "$ref": "#/$defs/v1_legacy" }
  ],
  "$defs": {
    "file_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "artifact_id": { "type": "string", "minLength": 1 }
      }
    },
    "policy_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["owner", "rule"],
      "properties": {
        "owner": { "const": "run_manifest.control" },
        "rule": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 }
      }
    },
    "audit_file_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "sha256": { "type": "string", "pattern": "^[A-Fa-f0-9]{64}$" }
      }
    },
    "ai_usage_record": {
      "type": "object",
      "additionalProperties": false,
      "required": ["usage_id", "tool_name", "model", "provider", "used_at", "stage", "purpose", "prompt_summary", "output_use", "human_changes", "interaction_record", "verification"],
      "properties": {
        "usage_id": { "type": "string", "minLength": 1 },
        "tool_name": { "type": "string", "minLength": 1 },
        "model": { "type": "string", "minLength": 1 },
        "provider": { "type": "string", "minLength": 1 },
        "used_at": { "type": "string", "minLength": 1 },
        "stage": { "type": "string", "enum": ["analysis", "modeling", "coding", "experiments", "writing", "review", "submission", "other"] },
        "purpose": { "type": "string", "minLength": 1 },
        "prompt_summary": { "type": "string", "minLength": 1 },
        "output_use": { "type": "string", "minLength": 1 },
        "human_changes": { "type": "string", "minLength": 1 },
        "interaction_record": { "$ref": "#/$defs/audit_file_ref" },
        "verification": {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "checked_by_role", "method", "checked_at"],
          "properties": {
            "status": { "type": "string", "enum": ["pending", "verified", "rejected"] },
            "checked_by_role": { "type": "string", "minLength": 1 },
            "method": { "type": "string", "minLength": 1 },
            "checked_at": { "type": "string", "minLength": 1 }
          }
        }
      }
    },
    "v2": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "project_id",
        "run_id",
        "status",
        "stage",
        "preset",
        "profile_overrides",
        "competition_profile_ref",
        "roots",
        "control",
        "safety",
        "ai_usage",
        "human_checkpoints"
      ],
      "properties": {
        "schema_version": { "const": "2.0" },
        "project_id": { "type": "string", "minLength": 1 },
        "run_id": { "type": "string", "minLength": 1 },
        "status": { "type": "string", "enum": ["active", "frozen", "content_ready", "submission_ready", "blocked"] },
        "stage": { "type": "string", "enum": ["analysis", "coding", "results", "evidence", "paper", "review", "submission"] },
        "preset": { "type": "string", "enum": ["sprint", "research", "submission"] },
        "profile_overrides": { "type": "object" },
        "competition_profile_ref": {
          "type": "object",
          "additionalProperties": false,
          "required": ["path", "profile_id"],
          "properties": {
            "path": { "type": "string", "minLength": 1 },
            "profile_id": { "type": "string", "minLength": 1 },
            "artifact_id": { "type": "string", "minLength": 1 }
          }
        },
        "roots": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "model_contract": { "$ref": "#/$defs/file_ref" },
            "artifact_dag": { "$ref": "#/$defs/file_ref" },
            "run_index": { "$ref": "#/$defs/file_ref" },
            "evidence_registry": { "$ref": "#/$defs/file_ref" },
            "paper_plan": { "$ref": "#/$defs/file_ref" },
            "submission_manifest": { "$ref": "#/$defs/file_ref" }
          }
        },
        "control": {
          "type": "object",
          "additionalProperties": false,
          "required": ["selection_policy"],
          "properties": {
            "selection_policy": { "$ref": "#/$defs/policy_ref" },
            "revision": {
              "type": "object",
              "additionalProperties": false,
              "required": ["loop", "cap", "open_issue_ids"],
              "properties": {
                "loop": { "type": "integer", "minimum": 0 },
                "cap": { "type": "integer", "minimum": 0 },
                "open_issue_ids": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
                "decision_memo": { "type": "string" }
              }
            },
            "required_human_stages": {
              "type": "array",
              "uniqueItems": true,
              "items": { "type": "string", "enum": ["m1", "p2", "w1", "w2", "s1", "f1"] }
            },
            "historical_evidence_policy": { "const": "preserve" }
          }
        },
        "safety": { "type": "object" },
        "ai_usage_state": { "type": "string", "enum": ["unknown", "none", "used"] },
        "ai_usage_declaration": {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "confirmed_by", "confirmed_at", "reason"],
          "properties": {
            "status": { "const": "none" },
            "confirmed_by": { "type": "string", "minLength": 1 },
            "confirmed_at": { "type": "string", "minLength": 1 },
            "reason": { "type": "string", "minLength": 1 }
          }
        },
        "ai_usage": { "type": "array", "items": { "$ref": "#/$defs/ai_usage_record" } },
        "human_checkpoints": { "type": "array" },
        "metadata": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "normalized_from": { "type": "string", "minLength": 1 },
            "normalization_boundary": { "const": "v1_adapter" }
          }
        }
      }
    },
    "v1_legacy": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "schema_version",
        "project_id",
        "run_id",
        "status",
        "phase",
        "competition_profile",
        "safety",
        "ai_usage",
        "human_checkpoints",
        "model_contract",
        "enhanced_integrity_profile",
        "integrity_mode",
        "gates",
        "commands",
        "artifacts",
        "revision",
        "reviewer"
      ],
      "properties": {
        "schema_version": { "type": "string", "enum": ["1.0", "1.1", "1.2", "1.3"] },
        "project_id": { "type": "string", "minLength": 1 },
        "run_id": { "type": "string", "minLength": 1 },
        "status": { "type": "string" },
        "phase": { "type": "string" },
        "competition_profile": { "type": "object" },
        "safety": { "type": "object" },
        "ai_usage": { "type": "array" },
        "human_checkpoints": { "type": "array" },
        "model_contract": { "type": "object" },
        "enhanced_integrity_profile": { "type": "boolean" },
        "math_correctness_profile": { "type": "string" },
        "editorial_semantics_profile": { "type": "string" },
        "integrity_mode": { "type": "string" },
        "gates": { "type": "object" },
        "commands": { "type": "array" },
        "artifacts": { "type": "array" },
        "revision": { "type": "object" },
        "reviewer": { "type": "object" }
      }
    }
  }
}
