{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/math-modeling-harness/run-index.schema.json",
  "title": "Run Index and Selection Ledger",
  "description": "Append-style ledger of every recorded run (including failures) plus the pre-declared selection policy. Prevents best-seed-only reporting: all candidate/tuning/final runs stay visible, and 'selected' is a claim against the declared policy.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "selection_policy", "runs"],
  "properties": {
    "schema_version": {"type": "string", "const": "1.0"},
    "run_id_scope": {"type": "string", "minLength": 1},
    "selection_policy": {"type": "string", "minLength": 1, "description": "Pre-declared rule for choosing the selected run, e.g. 'highest strict-occlusion duration among feasible full runs; ties broken by earlier run'."},
    "runs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["command_id", "run_id", "stage", "argv", "exit_code", "receipt_path", "selected", "recorded_at"],
        "properties": {
          "command_id": {"type": "string", "minLength": 1},
          "run_id": {"type": "string", "minLength": 1},
          "stage": {"type": "string", "minLength": 1},
          "argv": {"type": "array", "minItems": 1, "items": {"type": "string"}},
          "exit_code": {"type": "integer"},
          "receipt_path": {"type": "string", "minLength": 1},
          "selected": {"type": "boolean"},
          "note": {"type": "string"},
          "recorded_at": {"type": "string", "minLength": 1}
        }
      }
    }
  }
}
