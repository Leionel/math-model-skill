{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/math-modeling-harness/oos-artifact.schema.json",
  "title": "Independent Out-of-Sample Artifact",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "oos_id", "run_id", "question_id", "status", "split_rule", "train_scenarios", "test_scenarios", "disjoint_check", "leakage_check", "metrics_artifact", "generated_at"],
  "properties": {
    "schema_version": {"type": "string", "const": "1.0"},
    "oos_id": {"type": "string", "minLength": 1},
    "run_id": {"type": "string", "minLength": 1},
    "question_id": {"type": "string", "pattern": "^q[1-9][0-9]*$"},
    "status": {"type": "string", "const": "verified"},
    "split_rule": {"type": "string", "minLength": 1},
    "train_scenarios": {"$ref": "#/$defs/scenario_set"},
    "test_scenarios": {"$ref": "#/$defs/scenario_set"},
    "disjoint_check": {"type": "string", "const": "PASS"},
    "leakage_check": {"type": "string", "const": "PASS"},
    "metrics_artifact": {"$ref": "#/$defs/file_ref"},
    "generated_at": {"type": "string", "minLength": 1}
  },
  "$defs": {
    "file_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[A-Fa-f0-9]{64}$"}
      }
    },
    "scenario_set": {
      "type": "object",
      "additionalProperties": false,
      "required": ["seed", "hash", "count", "source"],
      "properties": {
        "seed": {"type": "integer"},
        "hash": {"type": "string", "pattern": "^[A-Fa-f0-9]{64}$"},
        "count": {"type": "integer", "minimum": 1},
        "source": {"type": "string", "minLength": 1}
      }
    }
  }
}
