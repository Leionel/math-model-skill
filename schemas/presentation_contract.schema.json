{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/math-modeling-harness/presentation-contract.schema.json",
  "title": "Result Presentation Contract",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "run_id", "frozen_results", "entries", "status"],
  "properties": {
    "schema_version": {"type": "string", "const": "1.0"},
    "run_id": {"type": "string", "minLength": 1},
    "frozen_results": {"$ref": "#/$defs/file_ref"},
    "entries": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/entry"}},
    "status": {"type": "string", "enum": ["draft", "ready", "superseded"]}
  },
  "$defs": {
    "file_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[A-Fa-f0-9]{64}$"}
      }
    },
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["presentation_id", "result_id", "macro", "format", "unit_display", "rounding", "locations"],
      "properties": {
        "presentation_id": {"type": "string", "minLength": 1},
        "result_id": {"type": "string", "minLength": 1},
        "macro": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9]*$"},
        "format": {"type": "string", "enum": ["number", "percentage", "scientific", "currency", "interval", "text"]},
        "unit_display": {"type": "string"},
        "rounding": {"type": "string", "enum": ["frozen_display_value", "half_up", "significant_figures", "floor", "ceil", "none"]},
        "digits": {"type": "integer", "minimum": 0, "maximum": 12},
        "scale": {"type": "number"},
        "prefix": {"type": "string"},
        "suffix": {"type": "string"},
        "safe_side": {"type": "string", "enum": ["none", "lower_bound", "upper_bound", "exact"]},
        "feasibility_recheck": {"$ref": "#/$defs/feasibility_recheck"},
        "locations": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "enum": ["abstract", "body", "caption", "table", "conclusion"]}}
      }
    },
    "feasibility_recheck": {
      "type": "object",
      "additionalProperties": false,
      "required": ["expression", "display_symbol", "operator", "limit", "unit", "abs_tolerance", "rel_tolerance"],
      "properties": {
        "expression": {"type": "string", "minLength": 1},
        "display_symbol": {"type": "string", "minLength": 1},
        "operator": {"type": "string", "enum": ["<", "<=", "==", ">=", ">"]},
        "limit": {"type": "number"},
        "substitutions": {"type": "object", "additionalProperties": {"type": "number"}},
        "unit": {"type": "string", "minLength": 1},
        "abs_tolerance": {"type": "number", "minimum": 0},
        "rel_tolerance": {"type": "number", "minimum": 0},
        "source_locator": {"type": "string", "minLength": 1}
      }
    }
  }
}
