{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/math-modeling-harness/paper-plan.schema.json",
  "title": "Paper Plan",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "run_id", "central_thesis", "requirements", "claims", "sections", "argument_units", "precision_policy", "abstract_results", "terminology", "figures", "tables", "status"],
  "properties": {
    "schema_version": {"type": "string", "enum": ["1.2", "1.3"]},
    "run_id": {"type": "string", "minLength": 1},
    "central_thesis": {"$ref": "#/$defs/central_thesis"},
    "requirements": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/requirement"}},
    "claims": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/claim"}},
    "sections": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/section"}},
    "argument_units": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/argument_unit"}},
    "depth_budget": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/depth_budget"}},
    "precision_policy": {"$ref": "#/$defs/precision_policy"},
    "abstract_results": {"type": "array", "minItems": 1, "maxItems": 6, "items": {"$ref": "#/$defs/abstract_result"}},
    "nonresearch_numeric_literals": {"type": "array", "items": {"$ref": "#/$defs/nonresearch_numeric_literal"}},
    "terminology": {"type": "array", "items": {"$ref": "#/$defs/term"}},
    "figures": {"type": "array", "items": {"$ref": "#/$defs/figure"}},
    "figure_references": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/figure_reference"}},
    "tables": {"type": "array", "items": {"$ref": "#/$defs/table"}},
    "deliverables": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/deliverable"}},
    "draft_coverage": {"$ref": "#/$defs/draft_coverage"},
    "readiness": {"$ref": "#/$defs/readiness"},
    "canonical_recommendation": {"type": "object", "additionalProperties": false, "required": ["text", "evidence_ids"], "properties": {"text": {"type": "string", "minLength": 1}, "evidence_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}}},
    "status": {"type": "string", "enum": ["draft", "ready", "superseded"]}
  },
  "allOf": [
    {
      "oneOf": [
        {
          "properties": {
            "schema_version": {"const": "1.2"},
            "argument_units": {"items": {"allOf": [{"$ref": "#/$defs/argument_unit"}, {"required": ["target_words"]}]}}
          },
          "required": ["depth_budget"]
        },
        {
          "properties": {
            "schema_version": {"const": "1.3"},
            "argument_units": {"items": {"allOf": [{"$ref": "#/$defs/argument_unit"}, {"required": ["depth_priority"]}]}},
            "figures": {"items": {"allOf": [{"$ref": "#/$defs/figure"}, {"required": ["audience"]}]}}
          }
        }
      ]
    }
  ],
  "$defs": {
    "deliverable": {
      "type": "object",
      "additionalProperties": false,
      "required": ["deliverable_id", "type", "required_by_profile", "source_refs", "status"],
      "properties": {
        "deliverable_id": {"type": "string", "minLength": 1},
        "type": {"type": "string", "enum": ["main_paper", "paper_appendix", "ai_report", "code_appendix", "supplementary_tables", "official_result_workbook", "support_material", "submission_package"]},
        "title": {"type": "string", "minLength": 1},
        "required_by_profile": {"type": "boolean"},
        "target_path": {"type": "string", "minLength": 1},
        "source_refs": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "status": {"type": "string", "enum": ["planned", "ready", "verified", "not_applicable"]},
        "notes": {"type": "string"}
      }
    },
    "readiness": {
      "type": "object",
      "additionalProperties": false,
      "required": ["stage", "question_coverage"],
      "properties": {
        "stage": {"type": "string", "enum": ["outline", "technical_draft", "content_ready"]},
        "question_coverage": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/question_coverage"}}
      }
    },
    "question_coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["question_id", "formulation_unit_ids", "result_unit_ids", "validation_unit_ids", "interpretation_unit_ids", "display_ids"],
      "properties": {
        "question_id": {"type": "string", "pattern": "^q[1-9][0-9]*$"},
        "formulation_unit_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "result_unit_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "validation_unit_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "interpretation_unit_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "display_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "display_waiver": {"type": "string", "minLength": 1}
      },
      "anyOf": [
        {"properties": {"display_ids": {"minItems": 1}}},
        {"required": ["display_waiver"]}
      ]
    },
    "central_thesis": {
      "type": "object",
      "additionalProperties": false,
      "required": ["text", "claim_ids", "boundary"],
      "properties": {
        "text": {"type": "string", "minLength": 1},
        "claim_ids": {"type": "array", "minItems": 1, "maxItems": 5, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "boundary": {"type": "string", "minLength": 1}
      }
    },
    "requirement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["requirement_id", "text", "claim_ids"],
      "properties": {
        "requirement_id": {"type": "string", "minLength": 1},
        "text": {"type": "string", "minLength": 1},
        "claim_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
      }
    },
    "claim": {
      "type": "object",
      "additionalProperties": false,
      "required": ["claim_id", "claim_type", "text", "question_id", "evidence_ids", "section", "boundary", "support_level"],
      "properties": {
        "claim_id": {"type": "string", "minLength": 1},
        "claim_type": {"type": "string", "enum": ["observation", "inference", "recommendation"]},
        "text": {"type": "string", "minLength": 1},
        "question_id": {"type": "string", "pattern": "^q[1-9][0-9]*$"},
        "evidence_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "result_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "derived_result_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "section": {"type": "string", "minLength": 1},
        "boundary": {"type": "string", "minLength": 1},
        "support_level": {"type": "string", "enum": ["direct", "qualified", "tentative"]},
        "comparison": {"$ref": "#/$defs/comparison"},
        "contradicting_evidence_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "alternative_explanations": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "precondition_claim_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "inference_strength": {"type": "string", "enum": ["descriptive", "associational", "mechanistic", "causal"]},
        "causal_design": {"type": "string", "minLength": 1}
      }
    },
    "comparison": {
      "type": "object",
      "additionalProperties": false,
      "required": ["comparator", "metric", "direction", "scenario"],
      "properties": {
        "comparator": {"type": "string", "minLength": 1},
        "metric": {"type": "string", "minLength": 1},
        "direction": {"type": "string", "enum": ["higher_is_better", "lower_is_better", "noninferior", "different"]},
        "scenario": {"type": "string", "minLength": 1}
      }
    },
    "section": {
      "type": "object",
      "additionalProperties": false,
      "required": ["section_id", "purpose", "claim_ids"],
      "properties": {
        "section_id": {"type": "string", "minLength": 1},
        "role": {"type": "string", "minLength": 1},
        "purpose": {"type": "string", "minLength": 1},
        "claim_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
      }
    },
    "argument_scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type"],
      "properties": {
        "type": {"type": "string", "enum": ["question", "cross_question", "global"]},
        "question_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^q[1-9][0-9]*$"}
        }
      },
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "question_ids"],
          "properties": {
            "type": {"const": "question"},
            "question_ids": {"type": "array", "minItems": 1, "maxItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^q[1-9][0-9]*$"}}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "question_ids"],
          "properties": {
            "type": {"const": "cross_question"},
            "question_ids": {"type": "array", "minItems": 2, "uniqueItems": true, "items": {"type": "string", "pattern": "^q[1-9][0-9]*$"}}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type"],
          "properties": {"type": {"const": "global"}}
        }
      ]
    },
    "depth_priority": {
      "type": "object",
      "additionalProperties": false,
      "required": ["level", "rationale"],
      "properties": {
        "level": {"type": "string", "enum": ["core", "supporting", "compact"]},
        "rationale": {"type": "string", "minLength": 1}
      }
    },
    "argument_unit": {
      "type": "object",
      "additionalProperties": false,
      "required": ["unit_id", "section_id", "rhetorical_role", "claim_ids", "evidence_ids", "prerequisite_unit_ids", "expected_reader_judgment", "boundary"],
      "properties": {
        "unit_id": {"type": "string", "minLength": 1},
        "section_id": {"type": "string", "minLength": 1},
        "scope": {"$ref": "#/$defs/argument_scope"},
        "rhetorical_role": {"type": "string", "enum": ["problem_tension", "model_choice", "mechanism_derivation", "parameter_evidence", "result_observation", "comparison", "validation", "interpretation", "boundary", "recommendation"]},
        "claim_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "evidence_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "prerequisite_unit_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "model_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "equation_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "replay_case_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "constraint_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "validation_obligation_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "result_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "derived_result_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "math_locators": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "expected_reader_judgment": {"type": "string", "minLength": 1},
        "boundary": {"type": "string", "minLength": 1},
        "target_words": {"type": "integer", "minimum": 40},
        "depth_priority": {"$ref": "#/$defs/depth_priority"}
      }
    },
    "draft_coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "anchors"],
      "properties": {
        "status": {"type": "string", "enum": ["planned", "verified"]},
        "anchors": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/draft_anchor"}}
      }
    },
    "draft_anchor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["anchor_id", "unit_id", "patterns"],
      "properties": {
        "anchor_id": {"type": "string", "minLength": 1},
        "unit_id": {"type": "string", "minLength": 1},
        "question_id": {"type": "string", "pattern": "^q[1-9][0-9]*$"},
        "patterns": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "minimum_words": {"type": "integer", "minimum": 20}
      }
    },
    "depth_budget": {
      "type": "object",
      "additionalProperties": false,
      "required": ["question_id", "target_words", "rationale"],
      "properties": {
        "question_id": {"type": "string", "pattern": "^q[1-9][0-9]*$"},
        "target_words": {"type": "integer", "minimum": 80},
        "rationale": {"type": "string", "minLength": 1}
      }
    },
    "precision_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["audit_source", "prose_source", "table_source", "abstract_max_numeric_claims"],
      "properties": {
        "audit_source": {"type": "string", "const": "frozen_display_value"},
        "prose_source": {"type": "string", "const": "frozen_display_value"},
        "table_source": {"type": "string", "const": "frozen_display_value"},
        "abstract_max_numeric_claims": {"type": "integer", "minimum": 1, "maximum": 6}
      }
    },
    "abstract_result": {
      "type": "object",
      "additionalProperties": false,
      "required": ["result_id", "priority", "selection_reason", "claim_ids", "word_budget"],
      "properties": {
        "result_id": {"type": "string", "minLength": 1},
        "priority": {"type": "string", "enum": ["primary", "secondary"]},
        "selection_reason": {"type": "string", "minLength": 1},
        "claim_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "word_budget": {"type": "integer", "minimum": 8, "maximum": 100},
        "question_id": {"type": "string", "pattern": "^q[1-9][0-9]*$"},
        "method_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "validation_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "abstract_span": {"type": "string", "minLength": 1},
        "boundary": {"type": "string", "minLength": 1},
        "fact_check": {"$ref": "#/$defs/abstract_fact_check"}
      }
    },
    "abstract_fact_check": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "checked_fields", "source_ids"],
      "properties": {
        "status": {"type": "string", "enum": ["not_started", "passed", "needs_revision"]},
        "checked_fields": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "enum": ["question_id", "model_identity", "display_value", "unit", "comparison", "validation", "boundary"]}},
        "source_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "notes": {"type": "string"}
      }
    },
    "nonresearch_numeric_literal": {
      "type": "object",
      "additionalProperties": false,
      "required": ["token", "reason"],
      "properties": {
        "token": {"type": "string", "pattern": "^[-+]?(?:[0-9]+(?:\\.[0-9]*)?|\\.[0-9]+)(?:[eE][-+]?[0-9]+)?$"},
        "reason": {"type": "string", "minLength": 1}
      }
    },
    "term": {
      "type": "object",
      "additionalProperties": false,
      "required": ["canonical", "forbidden_variants"],
      "properties": {
        "canonical": {"type": "string", "minLength": 1},
        "forbidden_variants": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "semantic_id": {"type": "string", "minLength": 1},
        "canonical_zh": {"type": "string", "minLength": 1},
        "canonical_en": {"type": "string", "minLength": 1},
        "symbol": {"type": "string", "minLength": 1},
        "unit": {"type": "string", "minLength": 1},
        "allowed_aliases": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
      }
    },
    "figure_reference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reference_id", "figure_id", "reference_role", "section_id"],
      "properties": {
        "reference_id": {"type": "string", "minLength": 1},
        "figure_id": {"type": "string", "minLength": 1},
        "reference_role": {"type": "string", "enum": ["methodology_overview", "data_flow", "model_structure", "result_comparison", "sensitivity", "validation", "recommendation"]},
        "section_id": {"type": "string", "minLength": 1},
        "text_locator": {"type": "string", "minLength": 1}
      }
    },
    "figure": {
      "type": "object",
      "additionalProperties": false,
      "required": ["figure_id", "kind", "claim_ids", "evidence_ids", "purpose", "why_figure", "message", "comparison", "visual_encoding", "selection_rule", "data_artifacts", "panel_map", "statistical_definition", "paper_location", "caption_claim", "accessibility", "qa_status"],
      "properties": {
        "figure_id": {"type": "string", "minLength": 1},
        "kind": {"type": "string", "enum": ["data", "concept", "illustration"], "description": "data=由冻结数据确定性生成；concept=总览/流程/框架等结构图（默认 diagram_spec→draw.io 可编辑源，AI 位图仅在附 illustration 块并记录 backend_comparison 时可作为正式成品）；illustration=AI 生成的概念/机理/场景示意图（不承载数值结论）。"},
        "audience": {"type": "string", "enum": ["scientific_argument", "submission_disclosure", "internal_audit"], "description": "Reader-facing classification: scientific argument belongs in the paper body; submission disclosure is for an allowed disclosure deliverable; internal audit is Harness-only and cannot enter the reader-facing body."},
        "semantic_type": {"type": "string", "minLength": 1},
        "diagram": {"$ref": "#/$defs/diagram_artifact"},
        "illustration": {"$ref": "#/$defs/illustration_artifact"},
        "data_lineage": {"$ref": "#/$defs/data_lineage"},
        "canonical_source_id": {"type": "string", "minLength": 1},
        "claim_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "evidence_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "purpose": {"type": "string", "minLength": 1},
        "why_figure": {"type": "string", "minLength": 1},
        "message": {"type": "string", "minLength": 1},
        "comparison": {"type": "string", "minLength": 1},
        "visual_encoding": {"type": "string", "minLength": 1},
        "selection_rule": {"type": "string", "minLength": 1},
        "data_artifacts": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "panel_map": {"type": "object", "minProperties": 1, "additionalProperties": {"type": "string", "minLength": 1}},
        "statistical_definition": {"type": "string", "minLength": 1},
        "paper_location": {"type": "string", "minLength": 1},
        "caption_claim": {"type": "string", "minLength": 1},
        "data_shape": {"type": "string", "enum": ["distribution", "ordered_categories", "unordered_categories", "time_series", "continuous_relationship", "correlation_matrix", "diverging_matrix", "grid_search", "spatial", "network", "uncertainty_interval", "grouped_distribution", "other"]},
        "argument_intent": {"type": "string", "enum": ["distribution", "comparison", "relationship", "trend", "composition", "correlation", "uncertainty", "mechanism", "optimization_landscape", "process", "overview", "recommendation", "other"]},
        "sample_regime": {"$ref": "#/$defs/sample_regime"},
        "uncertainty_semantics": {"type": "string", "minLength": 1},
        "color_semantic_center": {"type": ["number", "string"]},
        "color_profile": {"type": "string", "enum": ["contest_default", "colorblind_safe", "muted", "high_contrast"]},
        "candidate_displays": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/candidate_display"}},
        "selected_display": {"type": "string", "minLength": 1},
        "selection_reason": {"type": "string", "minLength": 1},
        "final_size_qa": {"$ref": "#/$defs/final_size_qa"},
        "accessibility": {
          "type": "object",
          "additionalProperties": false,
          "required": ["grayscale_safe", "colorblind_safe", "dual_axis", "dual_axis_justification"],
          "properties": {
            "grayscale_safe": {"type": "boolean"},
            "colorblind_safe": {"type": "boolean"},
            "dual_axis": {"type": "boolean"},
            "dual_axis_justification": {"type": ["string", "null"]}
          }
        },
        "qa_status": {"type": "string", "enum": ["pending", "passed", "failed"]}
      }
    },
    "sample_regime": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "n_total": {"type": "integer", "minimum": 0},
        "n_per_group": {"type": "object", "additionalProperties": {"type": "integer", "minimum": 0}},
        "groups": {"type": "integer", "minimum": 0},
        "ordered": {"type": "boolean"},
        "repeated_unit": {"type": "string", "minLength": 1},
        "grid_is_discrete": {"type": "boolean"},
        "notes": {"type": "string"}
      }
    },
    "candidate_display": {
      "type": "object",
      "additionalProperties": false,
      "required": ["display_id", "display_type", "argument_fit", "risk_notes"],
      "properties": {
        "display_id": {"type": "string", "minLength": 1},
        "display_type": {"type": "string", "minLength": 1},
        "argument_fit": {"type": "string", "minLength": 1},
        "risk_notes": {"type": "string", "minLength": 1}
      }
    },
    "final_size_qa": {
      "type": "object",
      "additionalProperties": false,
      "required": ["target_width_inch", "target_height_inch", "expected_scale", "min_effective_font_pt", "raster_dpi", "line_width_pt", "marker_size_pt", "readability", "cropping", "status"],
      "properties": {
        "target_width_inch": {"type": "number", "exclusiveMinimum": 0},
        "target_height_inch": {"type": "number", "exclusiveMinimum": 0},
        "expected_scale": {"type": "string", "minLength": 1},
        "min_effective_font_pt": {"type": "number", "minimum": 1},
        "raster_dpi": {"type": "integer", "minimum": 72},
        "line_width_pt": {"type": "number", "exclusiveMinimum": 0},
        "marker_size_pt": {"type": "number", "exclusiveMinimum": 0},
        "readability": {"type": "string", "enum": ["not_reviewed", "pass", "needs_review", "fail"]},
        "cropping": {"type": "string", "enum": ["not_reviewed", "pass", "needs_review", "fail"]},
        "status": {"type": "string", "enum": ["declared", "reviewed", "failed"]},
        "notes": {"type": "string"}
      }
    },
    "diagram_artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["spec_path", "source_format", "source_editability", "text_policy", "rendered_paths", "status", "human_review_required"],
      "properties": {
        "spec_path": {"type": "string", "minLength": 1},
        "source_format": {"type": "string", "enum": ["drawio", "svg", "figma", "pptx"]},
        "source_path": {"type": ["string", "null"]},
        "delivery_mode": {"type": "string", "enum": ["vector_preferred", "raster_allowed", "raster_only"]},
        "source_editability": {"type": "string", "enum": ["editable_source", "vector_only"]},
        "text_policy": {"type": "string", "enum": ["native_text", "outlined_text", "raster_text"]},
        "raster_dpi": {"type": ["integer", "null"], "minimum": 72},
        "rendered_paths": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "style_profile": {"type": "string", "minLength": 1},
        "status": {"type": "string", "enum": ["brief", "draft", "rendered", "reviewed"]},
        "human_review_required": {"type": "boolean", "const": true}
      }
    },
    "illustration_artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["generator", "prompt_path", "raster_dpi", "text_policy", "review_status"],
      "properties": {
        "generator": {"type": "string", "minLength": 1, "description": "生成工具/模型名，如 nano-banana / dalle-3；必须同步登记到 run_manifest.ai_usage[]"},
        "prompt_path": {"type": "string", "minLength": 1, "description": "提示词与生成参数的落盘路径，供审计复现"},
        "generation_record": {"type": "string", "description": "生成交互记录路径（可选）"},
        "raster_dpi": {"type": "number", "description": "正式成品位图分辨率；check_consistency 强制 >= 300"},
        "text_policy": {"type": "string", "enum": ["raster_text"]},
        "review_status": {"type": "string", "enum": ["pending", "reviewed", "failed"], "description": "正式 QA 前必须为 reviewed（人工/多模态视觉复核）"},
        "backend_comparison": {
          "type": "object",
          "additionalProperties": false,
          "required": ["alternatives", "selection_reason"],
          "properties": {
            "alternatives": {"type": "array", "minItems": 2, "items": {"type": "string", "minLength": 1}, "description": "参与对比的后端（至少含一个可编辑源后端，如 drawio）"},
            "selection_reason": {"type": "string", "minLength": 1, "description": "择优理由；kind=concept 附 illustration 块时必填，由 checker 强制"},
            "comparison_record": {"type": "string", "description": "对比记录文件路径（截图/评分），可选但建议"}
          }
        }
      }
    },
    "data_lineage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_kind", "generator_command", "input_artifacts", "output_artifact", "synthetic", "status"],
      "properties": {
        "source_kind": {"type": "string", "enum": ["solver_output", "frozen_result", "derived_result", "observed_data"]},
        "generator_command": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "input_artifacts": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "output_artifact": {"type": "string", "minLength": 1},
        "synthetic": {"type": "boolean", "const": false},
        "status": {"type": "string", "enum": ["declared", "generated", "verified"]}
      }
    },
    "table": {
      "type": "object",
      "additionalProperties": false,
      "required": ["table_id", "claim_ids", "evidence_ids", "purpose", "why_table", "data_artifacts", "columns", "statistical_definition", "paper_location", "caption_claim", "qa_status"],
      "properties": {
        "table_id": {"type": "string", "minLength": 1},
        "claim_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "evidence_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "purpose": {"type": "string", "minLength": 1},
        "why_table": {"type": "string", "minLength": 1},
        "canonical_source_id": {"type": "string", "minLength": 1},
        "data_artifacts": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "columns": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/table_column"}},
        "statistical_definition": {"type": "string", "minLength": 1},
        "paper_location": {"type": "string", "minLength": 1},
        "caption_claim": {"type": "string", "minLength": 1},
        "qa_status": {"type": "string", "enum": ["pending", "passed", "failed"]}
      }
    },
    "table_column": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "meaning", "unit", "source_result_ids"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "meaning": {"type": "string", "minLength": 1},
        "unit": {"type": "string", "minLength": 1},
        "source_result_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
      }
    }
  }
}
