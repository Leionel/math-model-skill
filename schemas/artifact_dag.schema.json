{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/math-modeling-harness/artifact-dag.schema.json",
  "title": "Artifact Dependency DAG",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "run_id", "nodes"],
  "properties": {
    "schema_version": {"type": "string", "const": "1.0"},
    "run_id": {"type": "string", "minLength": 1},
    "nodes": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/node"}}
  },
  "$defs": {
    "file_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[A-Fa-f0-9]{64}$"}
      }
    },
    "node": {
      "type": "object",
      "additionalProperties": false,
      "required": ["node_id", "kind", "inputs", "outputs", "command", "receipt", "upstream_digest", "status"],
      "properties": {
        "node_id": {"type": "string", "minLength": 1},
        "kind": {"type": "string", "enum": ["problem", "data", "preprocessing", "model", "validation", "freeze", "evidence", "paper_plan", "figure", "table", "latex", "pdf_qa", "submission"]},
        "inputs": {"type": "array", "items": {"$ref": "#/$defs/file_ref"}},
        "outputs": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/file_ref"}},
        "command": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "receipt": {"$ref": "#/$defs/file_ref"},
        "upstream_digest": {"type": "string", "pattern": "^[A-Fa-f0-9]{64}$"},
        "status": {"type": "string", "enum": ["current", "stale", "failed", "not_run"]}
      }
    }
  }
}
