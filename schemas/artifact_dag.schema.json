{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/math-modeling-harness/artifact-dag.schema.json",
  "title": "Artifact Dependency DAG (v2; v1 read compatibility)",
  "description": "v2 is the canonical artifact identity/dependency/lifecycle/freshness contract. A digest is optional for non-critical artifacts and has one owner only.",
  "oneOf": [
    { "$ref": "#/$defs/v2" },
    { "$ref": "#/$defs/v1_legacy" }
  ],
  "$defs": {
    "digest": {
      "type": "string",
      "pattern": "^[A-Fa-f0-9]{64}$"
    },
    "dependency": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifact_id", "relation"],
      "properties": {
        "artifact_id": { "type": "string", "minLength": 1 },
        "relation": { "type": "string", "minLength": 1 }
      }
    },
    "v2_node": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifact_id",
        "role",
        "path",
        "producer_id",
        "dependencies",
        "lifecycle",
        "freshness",
        "digest_owner"
      ],
      "properties": {
        "artifact_id": { "type": "string", "minLength": 1 },
        "role": { "type": "string", "minLength": 1 },
        "path": { "type": "string", "minLength": 1 },
        "producer_id": { "type": "string", "minLength": 1 },
        "dependencies": { "type": "array", "items": { "$ref": "#/$defs/dependency" } },
        "lifecycle": { "type": "string", "enum": ["mutable", "immutable", "frozen", "submission"] },
        "freshness": { "type": "string", "enum": ["current", "stale", "unknown", "not_run"] },
        "critical": { "type": "boolean", "default": false },
        "version": { "type": "string", "minLength": 1 },
        "created_at": { "type": "string", "minLength": 1 },
        "digest_owner": { "type": "string", "minLength": 1 },
        "digest_algorithm": { "type": "string", "enum": ["sha256"] },
        "sha256": { "$ref": "#/$defs/digest" },
        "digest": { "$ref": "#/$defs/digest" },
        "producer_receipt_id": { "type": "string", "minLength": 1 },
        "metadata": { "type": "object" }
      },
      "allOf": [
        {
          "not": { "required": ["sha256", "digest"] }
        },
        {
          "if": { "required": ["sha256"] },
          "then": { "required": ["digest_algorithm"] }
        },
        {
          "if": { "required": ["digest"] },
          "then": { "required": ["digest_algorithm"] }
        }
      ]
    },
    "v2": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "run_id", "nodes"],
      "properties": {
        "schema_version": { "const": "2.0" },
        "run_id": { "type": "string", "minLength": 1 },
        "nodes": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/v2_node" } },
        "generated_at": { "type": "string", "minLength": 1 },
        "projection": { "const": "artifact_identity_dependency" }
      }
    },
    "legacy_file_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "sha256": { "$ref": "#/$defs/digest" }
      }
    },
    "v1_node": {
      "type": "object",
      "additionalProperties": false,
      "required": ["node_id", "kind", "inputs", "outputs", "command", "receipt", "upstream_digest", "status"],
      "properties": {
        "node_id": { "type": "string", "minLength": 1 },
        "kind": { "type": "string", "minLength": 1 },
        "inputs": { "type": "array", "items": { "$ref": "#/$defs/legacy_file_ref" } },
        "outputs": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/legacy_file_ref" } },
        "command": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
        "receipt": { "$ref": "#/$defs/legacy_file_ref" },
        "upstream_digest": { "$ref": "#/$defs/digest" },
        "status": { "type": "string", "enum": ["current", "stale", "failed", "not_run"] }
      }
    },
    "v1_legacy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "run_id", "nodes"],
      "properties": {
        "schema_version": { "const": "1.0" },
        "run_id": { "type": "string", "minLength": 1 },
        "nodes": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/v1_node" } }
      }
    }
  }
}
