{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/math-modeling-harness/model-contract.schema.json",
  "title": "Math Modeling Model Contract",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "project_id", "run_id", "unit_system", "questions", "data_sources", "assumptions", "models", "terminology", "status"],
  "properties": {
    "schema_version": {"type": "string", "const": "1.3"},
    "project_id": {"type": "string", "minLength": 1},
    "run_id": {"type": "string", "minLength": 1},
    "unit_system": {"type": "string", "minLength": 1},
    "problem_statement": {"type": "string"},
    "contest": {"type": "object", "additionalProperties": true},
    "questions": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/question"}},
    "data_sources": {"type": "array", "items": {"$ref": "#/$defs/data_source"}},
    "assumptions": {"type": "array", "items": {"$ref": "#/$defs/assumption"}},
    "assumption_forks": {"type": "array", "items": {"$ref": "#/$defs/assumption_fork"}},
    "research_basis": {"$ref": "#/$defs/research_basis"},
    "models": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/model"}},
    "terminology": {"type": "array", "items": {"$ref": "#/$defs/term"}},
    "status": {"type": "string", "enum": ["draft", "ready", "superseded"]}
  },
  "$defs": {
    "question": {
      "type": "object",
      "additionalProperties": false,
      "required": ["question_id", "task", "conclusion_type", "inputs", "outputs"],
      "properties": {
        "question_id": {"type": "string", "pattern": "^q[1-9][0-9]*$"},
        "task": {"type": "string", "minLength": 1},
        "conclusion_type": {"type": "string", "minLength": 1},
        "inputs": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "outputs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "depends_on": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^q[1-9][0-9]*$"}}
      }
    },
    "data_source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["data_id", "path", "read_only", "origin", "license_or_terms", "transformations", "quality_checks"],
      "properties": {
        "data_id": {"type": "string", "minLength": 1},
        "path": {"type": "string", "minLength": 1},
        "read_only": {"type": "boolean", "const": true},
        "sha256": {"type": "string", "pattern": "^[A-Fa-f0-9]{64}$"},
        "origin": {"type": "string", "minLength": 1},
        "license_or_terms": {"type": "string", "minLength": 1},
        "transformations": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "quality_checks": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "unit_notes": {"type": "string"},
        "quality_notes": {"type": "string"}
      }
    },
    "research_basis": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "research_questions", "searches", "candidate_models", "decisions"],
      "properties": {
        "status": {"type": "string", "enum": ["draft", "verified"]},
        "research_questions": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/research_question"}},
        "searches": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/search_record"}},
        "candidate_models": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/candidate_model"}},
        "decisions": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/model_decision"}},
        "unresolved_questions": {"type": "array", "items": {"type": "string", "minLength": 1}}
      }
    },
    "research_question": {
      "type": "object",
      "additionalProperties": false,
      "required": ["research_id", "question_ids", "purpose", "chinese_keywords", "english_keywords"],
      "properties": {
        "research_id": {"type": "string", "minLength": 1},
        "question_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^q[1-9][0-9]*$"}},
        "purpose": {"type": "string", "minLength": 1},
        "chinese_keywords": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "english_keywords": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
      }
    },
    "search_record": {
      "type": "object",
      "additionalProperties": false,
      "required": ["search_id", "research_ids", "query", "language", "source", "searched_at", "candidate_count"],
      "properties": {
        "search_id": {"type": "string", "minLength": 1},
        "research_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "query": {"type": "string", "minLength": 1},
        "language": {"type": "string", "enum": ["zh", "en", "mixed"]},
        "source": {"type": "string", "enum": ["llm_knowledge", "web_search", "google_scholar", "openalex", "crossref", "cnki", "publisher", "official_repository", "local_method_library", "other"]},
        "searched_at": {"type": "string", "minLength": 1},
        "candidate_count": {"type": "integer", "minimum": 0},
        "evidence_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "notes": {"type": "string"}
      }
    },
    "candidate_model": {
      "type": "object",
      "additionalProperties": false,
      "required": ["candidate_id", "question_id", "name", "mechanism_fit", "assumptions", "data_requirements", "strengths", "weaknesses", "evidence_ids", "rejection_conditions", "decision"],
      "properties": {
        "candidate_id": {"type": "string", "minLength": 1},
        "question_id": {"type": "string", "pattern": "^q[1-9][0-9]*$"},
        "name": {"type": "string", "minLength": 1},
        "mechanism_fit": {"type": "string", "minLength": 1},
        "assumptions": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "data_requirements": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "strengths": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "weaknesses": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "evidence_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "rejection_conditions": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "decision": {"type": "string", "enum": ["selected", "backup", "rejected"]},
        "model_id": {"type": "string", "minLength": 1}
      }
    },
    "model_decision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["question_id", "selected_candidate_id", "alternatives_considered", "selection_criteria", "rationale", "decisive_evidence_ids", "unresolved_risks"],
      "properties": {
        "question_id": {"type": "string", "pattern": "^q[1-9][0-9]*$"},
        "selected_candidate_id": {"type": "string", "minLength": 1},
        "alternatives_considered": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "selection_criteria": {"type": "array", "minItems": 2, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "rationale": {"type": "string", "minLength": 1},
        "decisive_evidence_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "unresolved_risks": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "risk_disposition": {"type": "string", "minLength": 1},
        "single_candidate_waiver": {"type": "string", "minLength": 1}
      }
    },
    "assumption": {
      "type": "object",
      "additionalProperties": false,
      "required": ["assumption_id", "text", "basis", "sensitivity_plan"],
      "properties": {
        "assumption_id": {"type": "string", "minLength": 1},
        "text": {"type": "string", "minLength": 1},
        "basis": {"type": "string", "minLength": 1},
        "sensitivity_plan": {"type": "string", "minLength": 1}
      }
    },
    "assumption_fork": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fork_id", "phrase", "question_id", "interpretations", "checks"],
      "properties": {
        "fork_id": {"type": "string", "minLength": 1},
        "phrase": {"type": "string", "minLength": 1},
        "question_id": {"type": "string", "pattern": "^q[1-9][0-9]*$"},
        "interpretations": {"type": "array", "minItems": 2, "items": {"$ref": "#/$defs/fork_interpretation"}},
        "checks": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "selected": {"type": "string", "minLength": 1},
        "selection_reason": {"type": "string", "minLength": 1},
        "unresolved_risk": {"type": "string", "minLength": 1}
      }
    },
    "fork_interpretation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "meaning", "mathematical_effect"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "meaning": {"type": "string", "minLength": 1},
        "mathematical_effect": {"type": "string", "minLength": 1}
      }
    },
    "variable": {
      "type": "object",
      "additionalProperties": false,
      "required": ["symbol", "meaning", "unit", "domain", "role"],
      "properties": {
        "symbol": {"type": "string", "minLength": 1},
        "meaning": {"type": "string", "minLength": 1},
        "unit": {"type": "string", "minLength": 1},
        "domain": {"type": "string", "minLength": 1},
        "role": {"type": "string", "enum": ["decision", "parameter", "state", "index", "intermediate", "output"]}
      }
    },
    "constraint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["constraint_id", "expression", "meaning"],
      "properties": {
        "constraint_id": {"type": "string", "minLength": 1},
        "expression": {"type": "string", "minLength": 1},
        "meaning": {"type": "string", "minLength": 1}
      }
    },
    "validation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["check_id", "stage", "method", "acceptance"],
      "properties": {
        "check_id": {"type": "string", "minLength": 1},
        "stage": {"type": "string", "enum": ["smoke", "full", "both"]},
        "method": {"type": "string", "minLength": 1},
        "acceptance": {"type": "string", "minLength": 1}
      }
    },
    "validation_obligation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["obligation_id", "category", "method", "acceptance", "required_stage"],
      "properties": {
        "obligation_id": {"type": "string", "minLength": 1},
        "category": {"type": "string", "enum": ["data_quality", "feasibility", "objective_recomputation", "baseline", "out_of_sample", "leakage", "uncertainty", "sensitivity", "stability", "convergence", "numerical_error", "conservation", "nonanticipativity", "correlation_validity", "scenario_generalization", "other"]},
        "method": {"type": "string", "minLength": 1},
        "acceptance": {"$ref": "#/$defs/validation_acceptance"},
        "required_stage": {"type": "string", "enum": ["smoke", "full", "both"]},
        "artifact_role": {"type": "string", "enum": ["sensitivity_experiment", "oos_artifact", "failure_evidence"]}
      }
    },
    "validation_acceptance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["left_metric_id", "operator", "right", "unit"],
      "properties": {
        "left_metric_id": {"type": "string", "minLength": 1},
        "operator": {"type": "string", "enum": ["<=", "<", ">=", ">", "==", "!="]},
        "right": {"$ref": "#/$defs/validation_right_operand"},
        "unit": {"type": "string", "minLength": 1},
        "tolerance": {"type": "number", "minimum": 0}
      }
    },
    "validation_right_operand": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "value"],
          "properties": {
            "kind": {"type": "string", "const": "literal"},
            "value": {"type": "number"}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "metric_id"],
          "properties": {
            "kind": {"type": "string", "const": "metric"},
            "metric_id": {"type": "string", "minLength": 1}
          }
        }
      ]
    },
    "model": {
      "type": "object",
      "additionalProperties": false,
      "required": ["model_id", "question_id", "name", "problem_type", "rationale", "variables", "objective", "constraints", "algorithm", "inputs", "outputs", "validation", "validation_obligations", "risks", "fallback"],
      "properties": {
        "model_id": {"type": "string", "minLength": 1},
        "question_id": {"type": "string", "pattern": "^q[1-9][0-9]*$"},
        "name": {"type": "string", "minLength": 1},
        "problem_type": {"type": "string", "enum": ["optimization", "prediction", "classification", "time_series", "evaluation", "simulation", "differential_equation", "statistical_inference", "graph_network", "other"]},
        "characteristics": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "enum": ["deterministic", "stochastic", "scenario_based", "correlated_inputs", "multi_stage", "time_dependent", "spatial", "multiobjective", "causal", "machine_learning"]}},
        "rationale": {"type": "string", "minLength": 1},
        "variables": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/variable"}},
        "objective": {"type": "string", "minLength": 1},
        "constraints": {"type": "array", "items": {"$ref": "#/$defs/constraint"}},
        "algorithm": {"type": "string", "minLength": 1},
        "inputs": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "outputs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "validation": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/validation"}},
        "validation_obligations": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/validation_obligation"}},
        "risks": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "fallback": {"type": "string", "minLength": 1},
        "rejected_alternatives": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "identity": {"$ref": "#/$defs/model_identity"},
        "risk_semantics": {"$ref": "#/$defs/risk_semantics"},
        "correlation_spec": {"$ref": "#/$defs/correlation_spec"},
        "plan_details": {"$ref": "#/$defs/model_plan_details"}
      }
    },
    "model_plan_details": {
      "type": "object",
      "additionalProperties": false,
      "required": ["selected_candidate_id", "mechanism", "equation_plan", "parameter_plan", "implementation_steps", "output_artifacts", "validation_strategy", "failure_modes"],
      "properties": {
        "selected_candidate_id": {"type": "string", "minLength": 1},
        "mechanism": {"type": "string", "minLength": 1},
        "equation_plan": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/equation_plan"}},
        "parameter_plan": {"type": "array", "items": {"$ref": "#/$defs/parameter_plan"}},
        "implementation_steps": {"type": "array", "minItems": 3, "items": {"type": "string", "minLength": 1}},
        "output_artifacts": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "validation_strategy": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "failure_modes": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "derivation_graph": {"$ref": "#/$defs/derivation_graph"}
      }
    },
    "equation_plan": {
      "type": "object",
      "additionalProperties": false,
      "required": ["equation_id", "purpose", "expression_or_derivation", "variables", "assumptions"],
      "properties": {
        "equation_id": {"type": "string", "minLength": 1},
        "purpose": {"type": "string", "minLength": 1},
        "expression_or_derivation": {"type": "string", "minLength": 1},
        "variables": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "assumptions": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "equation_type": {"type": "string", "enum": ["definition", "derivation", "constraint", "objective", "approximation", "reformulation", "theorem_application", "state_update", "other"]},
        "math_risk": {"type": "string", "enum": ["low", "medium", "high"]},
        "inputs": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "outputs": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "symbols": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "domains": {"type": "object", "additionalProperties": {"type": "string", "minLength": 1}},
        "preconditions": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "transformation_rule": {"type": "string", "minLength": 1},
        "unit_signature": {"type": "string", "minLength": 1},
        "verification": {"$ref": "#/$defs/equation_verification"}
      }
    },
    "parameter_plan": {
      "type": "object",
      "additionalProperties": false,
      "required": ["parameter", "provenance", "unit", "uncertainty_or_range"],
      "properties": {
        "parameter": {"type": "string", "minLength": 1},
        "provenance": {"$ref": "#/$defs/parameter_provenance"},
        "semantic_role": {"type": "string", "minLength": 1},
        "unit": {"type": "string", "minLength": 1},
        "uncertainty_or_range": {"type": "string", "minLength": 1}
      }
    },
    "derivation_graph": {
      "type": "object",
      "additionalProperties": false,
      "required": ["nodes", "edges"],
      "properties": {
        "nodes": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/derivation_node"}},
        "edges": {"type": "array", "items": {"$ref": "#/$defs/derivation_edge"}},
        "source_node_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "terminal_node_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
      }
    },
    "derivation_node": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type", "inputs", "outputs"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "equation_id": {"type": "string", "minLength": 1},
        "type": {"type": "string", "enum": ["definition", "scenario_transform", "objective_component", "objective", "constraint", "state_update", "parameter_transform", "approximation", "reformulation", "theorem_application", "other"]},
        "inputs": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "outputs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
      }
    },
    "derivation_edge": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "equation_verification": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "symbol_check": {"$ref": "#/$defs/verification_status"},
        "domain_check": {"$ref": "#/$defs/verification_status"},
        "index_check": {"$ref": "#/$defs/verification_status"},
        "unit_check": {"$ref": "#/$defs/verification_status"},
        "boundary_check": {"$ref": "#/$defs/verification_status"},
        "precondition_check": {"$ref": "#/$defs/verification_status"},
        "symbolic_check": {"$ref": "#/$defs/verification_status"},
        "property_test_refs": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "semantic_test_refs": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "tiny_oracle_refs": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
      }
    },
    "verification_status": {
      "type": "string",
      "enum": ["PASS", "FAIL", "UNVERIFIED", "NOT_APPLICABLE"]
    },
    "parameter_provenance": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "source_locator"],
          "properties": {
            "type": {"type": "string", "const": "GIVEN"},
            "source_locator": {"type": "string", "minLength": 1},
            "notes": {"type": "string"}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "derivation_chain", "source_variables"],
          "properties": {
            "type": {"type": "string", "const": "DERIVED"},
            "derivation_chain": {"type": "string", "minLength": 1},
            "source_variables": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
            "notes": {"type": "string"}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "estimator", "sample_scope", "uncertainty"],
          "properties": {
            "type": {"type": "string", "const": "ESTIMATED"},
            "estimator": {"type": "string", "minLength": 1},
            "sample_scope": {"type": "string", "minLength": 1},
            "uncertainty": {"type": "string", "minLength": 1},
            "notes": {"type": "string"}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "calibration_data", "calibration_objective", "independent_validation"],
          "properties": {
            "type": {"type": "string", "const": "CALIBRATED"},
            "calibration_data": {"type": "string", "minLength": 1},
            "calibration_objective": {"type": "string", "minLength": 1},
            "independent_validation": {"type": "string", "minLength": 1},
            "notes": {"type": "string"}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "reason", "range", "sensitivity"],
          "properties": {
            "type": {"type": "string", "const": "ASSUMED"},
            "reason": {"type": "string", "minLength": 1},
            "range": {"type": "string", "minLength": 1},
            "sensitivity": {"type": "string", "minLength": 1},
            "notes": {"type": "string"}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "official_source", "rule_snapshot"],
          "properties": {
            "type": {"type": "string", "const": "POLICY"},
            "official_source": {"type": "string", "minLength": 1},
            "rule_snapshot": {"type": "string", "minLength": 1},
            "notes": {"type": "string"}
          }
        }
      ]
    },
    "model_identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["canonical_name", "mathematical_class", "objective_form", "forbidden_aliases"],
      "properties": {
        "canonical_name": {"type": "string", "minLength": 1},
        "mathematical_class": {"type": "string", "minLength": 1},
        "objective_form": {"type": "string", "minLength": 1},
        "forbidden_aliases": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "defining_equations": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
      }
    },
    "risk_semantics": {
      "type": "object",
      "additionalProperties": false,
      "required": ["random_variable", "tail", "confidence_level", "objective_direction"],
      "properties": {
        "random_variable": {"type": "string", "enum": ["profit", "loss"]},
        "tail": {"type": "string", "enum": ["upper", "lower"]},
        "confidence_level": {"type": "number", "minimum": 0, "maximum": 1},
        "objective_direction": {"type": "string", "enum": ["minimize", "maximize"]},
        "scenario_source": {"type": "string", "minLength": 1}
      }
    },
    "correlation_spec": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "sample_scope", "dimension", "min_eigenvalue", "checks"],
      "properties": {
        "source": {"type": "string", "minLength": 1},
        "sample_scope": {"type": "string", "minLength": 1},
        "dimension": {"type": "integer", "minimum": 2},
        "min_eigenvalue": {"type": "number"},
        "checks": {
          "type": "object",
          "additionalProperties": false,
          "required": ["in_unit_interval", "symmetric", "psd_verified"],
          "properties": {
            "in_unit_interval": {"type": "boolean"},
            "symmetric": {"type": "boolean"},
            "psd_verified": {"type": "boolean"}
          }
        }
      }
    },
    "term": {
      "type": "object",
      "additionalProperties": false,
      "required": ["canonical", "forbidden_variants"],
      "properties": {
        "canonical": {"type": "string", "minLength": 1},
        "forbidden_variants": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
      }
    }
  }
}
