{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/math-modeling-harness/model-contract.schema.json",
  "title": "Math Modeling Model Contract",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "project_id", "run_id", "unit_system", "questions", "data_sources", "assumptions", "models", "terminology", "status"],
  "properties": {
    "schema_version": {"type": "string", "const": "1.2"},
    "project_id": {"type": "string", "minLength": 1},
    "run_id": {"type": "string", "minLength": 1},
    "unit_system": {"type": "string", "minLength": 1},
    "problem_statement": {"type": "string"},
    "contest": {"type": "object", "additionalProperties": true},
    "questions": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/question"}},
    "data_sources": {"type": "array", "items": {"$ref": "#/$defs/data_source"}},
    "assumptions": {"type": "array", "items": {"$ref": "#/$defs/assumption"}},
    "research_basis": {"$ref": "#/$defs/research_basis"},
    "models": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/model"}},
    "terminology": {"type": "array", "items": {"$ref": "#/$defs/term"}},
    "status": {"type": "string", "enum": ["draft", "ready", "superseded"]}
  },
  "$defs": {
    "question": {
      "type": "object",
      "additionalProperties": false,
      "required": ["question_id", "task", "conclusion_type", "inputs", "outputs"],
      "properties": {
        "question_id": {"type": "string", "pattern": "^q[1-9][0-9]*$"},
        "task": {"type": "string", "minLength": 1},
        "conclusion_type": {"type": "string", "minLength": 1},
        "inputs": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "outputs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "depends_on": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^q[1-9][0-9]*$"}}
      }
    },
    "data_source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["data_id", "path", "read_only", "origin", "license_or_terms", "transformations", "quality_checks"],
      "properties": {
        "data_id": {"type": "string", "minLength": 1},
        "path": {"type": "string", "minLength": 1},
        "read_only": {"type": "boolean", "const": true},
        "sha256": {"type": "string", "pattern": "^[A-Fa-f0-9]{64}$"},
        "origin": {"type": "string", "minLength": 1},
        "license_or_terms": {"type": "string", "minLength": 1},
        "transformations": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "quality_checks": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "unit_notes": {"type": "string"},
        "quality_notes": {"type": "string"}
      }
    },
    "research_basis": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "research_questions", "searches", "candidate_models", "decisions"],
      "properties": {
        "status": {"type": "string", "enum": ["draft", "verified"]},
        "research_questions": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/research_question"}},
        "searches": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/search_record"}},
        "candidate_models": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/candidate_model"}},
        "decisions": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/model_decision"}},
        "unresolved_questions": {"type": "array", "items": {"type": "string", "minLength": 1}}
      }
    },
    "research_question": {
      "type": "object",
      "additionalProperties": false,
      "required": ["research_id", "question_ids", "purpose", "chinese_keywords", "english_keywords"],
      "properties": {
        "research_id": {"type": "string", "minLength": 1},
        "question_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^q[1-9][0-9]*$"}},
        "purpose": {"type": "string", "minLength": 1},
        "chinese_keywords": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "english_keywords": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
      }
    },
    "search_record": {
      "type": "object",
      "additionalProperties": false,
      "required": ["search_id", "research_ids", "query", "language", "source", "searched_at", "candidate_count"],
      "properties": {
        "search_id": {"type": "string", "minLength": 1},
        "research_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "query": {"type": "string", "minLength": 1},
        "language": {"type": "string", "enum": ["zh", "en", "mixed"]},
        "source": {"type": "string", "enum": ["llm_knowledge", "web_search", "google_scholar", "openalex", "crossref", "cnki", "publisher", "official_repository", "local_method_library", "other"]},
        "searched_at": {"type": "string", "minLength": 1},
        "candidate_count": {"type": "integer", "minimum": 0},
        "notes": {"type": "string"}
      }
    },
    "candidate_model": {
      "type": "object",
      "additionalProperties": false,
      "required": ["candidate_id", "question_id", "name", "mechanism_fit", "assumptions", "data_requirements", "strengths", "weaknesses", "evidence_ids", "rejection_conditions", "decision"],
      "properties": {
        "candidate_id": {"type": "string", "minLength": 1},
        "question_id": {"type": "string", "pattern": "^q[1-9][0-9]*$"},
        "name": {"type": "string", "minLength": 1},
        "mechanism_fit": {"type": "string", "minLength": 1},
        "assumptions": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "data_requirements": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "strengths": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "weaknesses": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "evidence_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "rejection_conditions": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "decision": {"type": "string", "enum": ["selected", "backup", "rejected"]},
        "model_id": {"type": "string", "minLength": 1}
      }
    },
    "model_decision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["question_id", "selected_candidate_id", "alternatives_considered", "selection_criteria", "rationale", "decisive_evidence_ids", "unresolved_risks"],
      "properties": {
        "question_id": {"type": "string", "pattern": "^q[1-9][0-9]*$"},
        "selected_candidate_id": {"type": "string", "minLength": 1},
        "alternatives_considered": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "selection_criteria": {"type": "array", "minItems": 2, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "rationale": {"type": "string", "minLength": 1},
        "decisive_evidence_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "unresolved_risks": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "single_candidate_waiver": {"type": "string", "minLength": 1}
      }
    },
    "assumption": {
      "type": "object",
      "additionalProperties": false,
      "required": ["assumption_id", "text", "basis", "sensitivity_plan"],
      "properties": {
        "assumption_id": {"type": "string", "minLength": 1},
        "text": {"type": "string", "minLength": 1},
        "basis": {"type": "string", "minLength": 1},
        "sensitivity_plan": {"type": "string", "minLength": 1}
      }
    },
    "variable": {
      "type": "object",
      "additionalProperties": false,
      "required": ["symbol", "meaning", "unit", "domain", "role"],
      "properties": {
        "symbol": {"type": "string", "minLength": 1},
        "meaning": {"type": "string", "minLength": 1},
        "unit": {"type": "string", "minLength": 1},
        "domain": {"type": "string", "minLength": 1},
        "role": {"type": "string", "enum": ["decision", "parameter", "state", "index", "intermediate", "output"]}
      }
    },
    "constraint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["constraint_id", "expression", "meaning"],
      "properties": {
        "constraint_id": {"type": "string", "minLength": 1},
        "expression": {"type": "string", "minLength": 1},
        "meaning": {"type": "string", "minLength": 1}
      }
    },
    "validation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["check_id", "stage", "method", "acceptance"],
      "properties": {
        "check_id": {"type": "string", "minLength": 1},
        "stage": {"type": "string", "enum": ["smoke", "full", "both"]},
        "method": {"type": "string", "minLength": 1},
        "acceptance": {"type": "string", "minLength": 1}
      }
    },
    "validation_obligation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["obligation_id", "category", "method", "acceptance", "required_stage"],
      "properties": {
        "obligation_id": {"type": "string", "minLength": 1},
        "category": {"type": "string", "enum": ["data_quality", "feasibility", "objective_recomputation", "baseline", "out_of_sample", "leakage", "uncertainty", "sensitivity", "stability", "convergence", "numerical_error", "conservation", "nonanticipativity", "correlation_validity", "scenario_generalization", "other"]},
        "method": {"type": "string", "minLength": 1},
        "acceptance": {"$ref": "#/$defs/validation_acceptance"},
        "required_stage": {"type": "string", "enum": ["smoke", "full", "both"]}
      }
    },
    "validation_acceptance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["left_metric_id", "operator", "right", "unit"],
      "properties": {
        "left_metric_id": {"type": "string", "minLength": 1},
        "operator": {"type": "string", "enum": ["<=", "<", ">=", ">", "==", "!="]},
        "right": {"$ref": "#/$defs/validation_right_operand"},
        "unit": {"type": "string", "minLength": 1},
        "tolerance": {"type": "number", "minimum": 0}
      }
    },
    "validation_right_operand": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "value"],
          "properties": {
            "kind": {"type": "string", "const": "literal"},
            "value": {"type": "number"}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "metric_id"],
          "properties": {
            "kind": {"type": "string", "const": "metric"},
            "metric_id": {"type": "string", "minLength": 1}
          }
        }
      ]
    },
    "model": {
      "type": "object",
      "additionalProperties": false,
      "required": ["model_id", "question_id", "name", "problem_type", "rationale", "variables", "objective", "constraints", "algorithm", "inputs", "outputs", "validation", "validation_obligations", "risks", "fallback"],
      "properties": {
        "model_id": {"type": "string", "minLength": 1},
        "question_id": {"type": "string", "pattern": "^q[1-9][0-9]*$"},
        "name": {"type": "string", "minLength": 1},
        "problem_type": {"type": "string", "enum": ["optimization", "prediction", "classification", "time_series", "evaluation", "simulation", "differential_equation", "statistical_inference", "graph_network", "other"]},
        "characteristics": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "enum": ["deterministic", "stochastic", "scenario_based", "correlated_inputs", "multi_stage", "time_dependent", "spatial", "multiobjective", "causal", "machine_learning"]}},
        "rationale": {"type": "string", "minLength": 1},
        "variables": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/variable"}},
        "objective": {"type": "string", "minLength": 1},
        "constraints": {"type": "array", "items": {"$ref": "#/$defs/constraint"}},
        "algorithm": {"type": "string", "minLength": 1},
        "inputs": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "outputs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "validation": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/validation"}},
        "validation_obligations": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/validation_obligation"}},
        "risks": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "fallback": {"type": "string", "minLength": 1},
        "rejected_alternatives": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "plan_details": {"$ref": "#/$defs/model_plan_details"}
      }
    },
    "model_plan_details": {
      "type": "object",
      "additionalProperties": false,
      "required": ["selected_candidate_id", "mechanism", "equation_plan", "parameter_plan", "implementation_steps", "output_artifacts", "validation_strategy", "failure_modes"],
      "properties": {
        "selected_candidate_id": {"type": "string", "minLength": 1},
        "mechanism": {"type": "string", "minLength": 1},
        "equation_plan": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/equation_plan"}},
        "parameter_plan": {"type": "array", "items": {"$ref": "#/$defs/parameter_plan"}},
        "implementation_steps": {"type": "array", "minItems": 3, "items": {"type": "string", "minLength": 1}},
        "output_artifacts": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "validation_strategy": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "failure_modes": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
      }
    },
    "equation_plan": {
      "type": "object",
      "additionalProperties": false,
      "required": ["equation_id", "purpose", "expression_or_derivation", "variables", "assumptions"],
      "properties": {
        "equation_id": {"type": "string", "minLength": 1},
        "purpose": {"type": "string", "minLength": 1},
        "expression_or_derivation": {"type": "string", "minLength": 1},
        "variables": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "assumptions": {"type": "array", "items": {"type": "string", "minLength": 1}}
      }
    },
    "parameter_plan": {
      "type": "object",
      "additionalProperties": false,
      "required": ["parameter", "source_or_estimator", "unit", "uncertainty_or_range"],
      "properties": {
        "parameter": {"type": "string", "minLength": 1},
        "source_or_estimator": {"type": "string", "minLength": 1},
        "unit": {"type": "string", "minLength": 1},
        "uncertainty_or_range": {"type": "string", "minLength": 1}
      }
    },
    "term": {
      "type": "object",
      "additionalProperties": false,
      "required": ["canonical", "forbidden_variants"],
      "properties": {
        "canonical": {"type": "string", "minLength": 1},
        "forbidden_variants": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
      }
    }
  }
}
