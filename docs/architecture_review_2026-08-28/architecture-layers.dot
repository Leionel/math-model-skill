// Math Modeling Evidence Harness — Layered ownership & planes (pre-remediation snapshot, 2026-08-28)
// Later implementation status: HANDOFF_2026-08-28.md
// Skills: system-modeler + graphviz. Shows the distinctive three-layer ownership
// (execution fact / projection / control) plus authoring plane and gate runtime.
digraph architecture_layers {
  rankdir=TB;
  graph [fontname="Helvetica", labelloc="t", compound=true,
         label="Internal Architecture — Ownership Planes & Truth Boundaries\n(pre-remediation snapshot, 2026-08-28)"];
  node  [fontname="Helvetica", fontsize=10];
  edge  [fontname="Helvetica", fontsize=8];

  // ===== Plane 1: Human authoring surface (editable source) =====
  subgraph cluster_author {
    label="Plane 1 — Human Authoring Surface (never overwritten by prepare)";
    style=filled; color="#34A853"; fillcolor="#F1F8F3";
    brief  [label="00_PROJECT_BRIEF.md\n01_RESEARCH_NOTES.md\n02_MODEL_DECISION.md\n03_SOLUTION_REPORT.md\npaper/00_PAPER_PLAN.md", shape=note, style=filled, fillcolor="#FFFFFF"];
  }

  // ===== Plane 2: Compiled IR / contracts =====
  subgraph cluster_ir {
    label="Plane 2 — Compiled IR / Contracts (schema-validated)";
    style=filled; color="#FBBC04"; fillcolor="#FEF7E0";
    compile [label="compile-to-IR\nresearch / model --compile / solve /\npaper plan --compile / figure", shape=box, style=filled, fillcolor="#FFFFFF"];
    contracts [label=".harness/contracts/*.json\nmodel_contract, data_contract,\npaper_plan, evidence_registry ...", shape=box, style=filled, fillcolor="#FFFFFF"];
    schemas [label="schemas/*.schema.json\n(30 JSON Schemas)", shape=cylinder, style=filled, fillcolor="#FFF7E0"];
  }

  // ===== Plane 3: Control plane =====
  subgraph cluster_control {
    label="Plane 3 — Control Plane (single control decision owner)";
    style=filled; color="#EA4335"; fillcolor="#FCE8E6";
    manifest [label="run_manifest.json\npreset / roots / control.selection_policy /\nrequired_human_stages / ai_usage_state", shape=box, style=filled, fillcolor="#FFFFFF"];
    profile  [label="competition_profile.json\nseed → verified (official snapshot)", shape=box, style=filled, fillcolor="#FFFFFF"];
  }

  // ===== Plane 4: Execution facts =====
  subgraph cluster_exec {
    label="Plane 4 — Execution Facts (immutable)";
    style=filled; color="#1A73E8"; fillcolor="#E8F0FE";
    receipt [label="command_receipt\n(process-captured argv/cwd/exit/stdout)\nSHA-256 of inputs BEFORE spawn, outputs after", shape=box, style=filled, fillcolor="#FFFFFF"];
    freeze  [label="frozen_results.json\nsubmission_manifest.json\n(status=frozen, validation_verdict=PASS, claimable)", shape=box, style=filled, fillcolor="#FFFFFF"];
  }

  // ===== Plane 5: Projections =====
  subgraph cluster_proj {
    label="Plane 5 — Projections (rebuildable, never 2nd source of truth)";
    style=filled; color="#9E9E9E"; fillcolor="#F1F3F4";
    runidx [label="run_index.json\n(append-only receipt ids + selected;\nnever copies exit_code)", shape=box, style=filled, fillcolor="#FFFFFF"];
    dag    [label="artifact_dag.json\n(digest ownership, freshness)", shape=box, style=filled, fillcolor="#FFFFFF"];
    views  [label=".harness/views/*.md\n(M1/W1/W2/S1 state, AI ledger, SUBMISSION_STATE)", shape=note, style=filled, fillcolor="#FFFFFF"];
  }

  // ===== Plane 6: Gate runtime =====
  subgraph cluster_gate {
    label="Plane 6 — Gate Runtime (re-derives, stores NO gate status)";
    style=filled; color="#673AB7"; fillcolor="#EDE7F6";
    gates [label="v2_gate_runtime._v2_gate()\n+ qa/check_gates.py\nM1 P1 P2 W1 W2 S1 (+S0 doctor, +F1 freeze_submission)", shape=box, style=filled, fillcolor="#FFFFFF"];
  }

  // ===== Knowledge base (side) =====
  subgraph cluster_kb {
    label="Knowledge Base (progressive disclosure)";
    style=filled; color="#00897B"; fillcolor="#E0F2F1";
    kb [label="references/router.md\nmethod / problem / failure cards,\ncontracts, validation profiles,\nwriting/figure/precedent refs", shape=box, style=filled, fillcolor="#FFFFFF"];
  }

  // ===== Flows =====
  brief   -> compile   [label="explicit compile", color="#34A853"];
  compile -> contracts [label="validates"];
  schemas -> contracts [label="schema-validated by", style=dashed];
  compile -> manifest  [label="registers root", style=dashed];
  manifest -> gates    [label="preset / policy / human stages", color="#EA4335"];
  profile  -> gates    [label="verified-status required at S1", color="#EA4335"];
  receipt  -> freeze   [label="semantic validation → accept → freeze", color="#1A73E8"];
  receipt  -> runidx   [label="append id (no exit_code)", color="#1A73E8"];
  receipt  -> dag      [label="digest owner binding", color="#1A73E8", style=dashed];
  freeze   -> gates    [label="re-hash & bind at W2/S1/F1", color="#1A73E8"];
  gates    -> runidx   [label="re-read receipts", style=dashed, color="#9E9E9E"];
  gates    -> dag      [label="freshness / digest-owner check", style=dashed, color="#9E9E9E"];
  gates    -> views    [label="prepare renders (SHA-256 header)", color="#9E9E9E"];
  kb       -> gates    [label="gate-specific refs", color="#00897B", style=dashed];

  // ===== Integrity rules (as note) =====
  rule [label="Integrity rules:\n• one digest owner per artifact\n• order: semantic validation → accept → freeze → hash bind\n• gates never trust manifest self-report; recompute\n• files are hand-editable; guarantee = re-derivation (no signatures)",
        shape=note, style=filled, fillcolor="#FFFDE7", fontsize=9];
  rule -> gates [style=invis];
}
